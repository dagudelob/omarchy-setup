#!/bin/bash

# Custom wrapper to support 'agy' / 'antigravity' in addition to standard Omarchy agents
agent_file="$HOME/.config/omarchy/defaults/agent"

if (($# == 0)); then
  if [[ -f $agent_file ]]; then
    read -r agent <"$agent_file"
  fi
  # Default to agy if unset, or migrate if still set to codex or gemini
  if [[ -z ${agent:-} || "$agent" == "codex" || "$agent" == "gemini" ]]; then
    agent="agy"
    mkdir -p "$(dirname "$agent_file")"
    printf 'agy\n' >"$agent_file"
  fi
  echo "$agent"
  exit 0
fi

case "$1" in
agy | antigravity | codex)
  mkdir -p "$(dirname "$agent_file")"
  printf 'agy\n' >"$agent_file"
  if [[ ${2:-} == "--inline" || ${1:-} == "--inline" ]]; then
    exec omarchy-agent --inline
  else
    exec omarchy-agent
  fi
  ;;
*)
  exec /usr/bin/omarchy-default-agent "$@"
  ;;
esac

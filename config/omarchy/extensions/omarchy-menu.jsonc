{
  // Setup > Default Agent customizations: Replace Codex with Antigravity (AGY)
  "setup.default.agent.codex": {
    "icon": "󰫢",
    "iconFont": "",
    "label": "Antigravity (AGY)",
    "checked": "[[ \"$(omarchy-default-agent)\" == \"agy\" || \"$(omarchy-default-agent)\" == \"antigravity\" ]]",
    "action": "omarchy-default-agent agy"
  },
  // Hide obsolete Gemini entry
  "setup.default.agent.gemini": {
    "when": "false"
  },
  // Surface Pen Studio Control Center
  "setup.surface-pen": {
    "icon": "󰏬",
    "label": "Surface Pen",
    "aliases": ["pen", "stylus", "surface-pen"],
    "action": "omarchy-surface-pen"
  }
}

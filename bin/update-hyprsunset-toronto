#!/usr/bin/env python3
import datetime
import math
import os
import subprocess
import sys

# Toronto coordinates
LAT = 43.6532
LON = -79.3832
CONFIG_PATH = os.path.expanduser("~/.config/hypr/hyprsunset.conf")
TARGET_TEMP = 3800

def get_solar_times(lat, lon, date=None):
    if date is None:
        date = datetime.date.today()
    day_of_year = date.timetuple().tm_yday
    gamma = 2 * math.pi / 365 * (day_of_year - 1 + (12 - 12) / 24)
    eqtime = 229.18 * (
        0.000075
        + 0.001868 * math.cos(gamma)
        - 0.032077 * math.sin(gamma)
        - 0.014615 * math.cos(2 * gamma)
        - 0.040849 * math.sin(2 * gamma)
    )
    decl = (
        0.006918
        - 0.399912 * math.cos(gamma)
        + 0.070257 * math.sin(gamma)
        - 0.006758 * math.cos(2 * gamma)
        + 0.000907 * math.sin(2 * gamma)
        - 0.002697 * math.cos(3 * gamma)
        + 0.00148 * math.sin(3 * gamma)
    )
    zenith = math.radians(90.833)  # Standard atmospheric refraction
    lat_rad = math.radians(lat)

    cos_ha = (math.cos(zenith) / (math.cos(lat_rad) * math.cos(decl))) - (
        math.tan(lat_rad) * math.tan(decl)
    )
    if cos_ha > 1 or cos_ha < -1:
        return "07:00", "19:00"

    ha_deg = math.degrees(math.acos(cos_ha))
    solar_noon_utc = 720 - (4 * lon) - eqtime
    sunrise_utc = solar_noon_utc - (ha_deg * 4)
    sunset_utc = solar_noon_utc + (ha_deg * 4)

    local_now = datetime.datetime.now().astimezone()
    tz_offset_min = local_now.utcoffset().total_seconds() / 60

    sr_local = (sunrise_utc + tz_offset_min) % 1440
    ss_local = (sunset_utc + tz_offset_min) % 1440

    sunrise_str = f"{int(sr_local // 60):02d}:{int(sr_local % 60):02d}"
    sunset_str = f"{int(ss_local // 60):02d}:{int(ss_local % 60):02d}"
    return sunrise_str, sunset_str

def main():
    sunrise, sunset = get_solar_times(LAT, LON)
    config_content = f"""# Automatically updated by update-hyprsunset-toronto
# Solar times for Toronto (Lat: {LAT}, Lon: {LON})
profile {{
    time = {sunrise}
    identity = true
}}

profile {{
    time = {sunset}
    temperature = {TARGET_TEMP}
}}
"""
    with open(CONFIG_PATH, "w") as f:
        f.write(config_content)
    
    print(f"Updated {CONFIG_PATH} with Toronto times: Sunrise {sunrise}, Sunset {sunset}")

    # Reload hyprsunset if running
    try:
        subprocess.run(["omarchy-restart-hyprsunset"], check=False)
    except Exception as e:
        pass

if __name__ == "__main__":
    main()
